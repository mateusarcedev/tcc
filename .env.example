# Backend / hardware
SERIAL_ENABLED=false
ARDUINO_PORT=/dev/cu.usbserial-120
BAUD_RATE=9600
# Firmware sends ACK after the ~2 s routing action; keep this above that duration.
SERIAL_ACK_TIMEOUT_SECONDS=5
SERIAL_WRITE_TIMEOUT_SECONDS=1
DATABASE_PATH=api/pacotes.db
DATABASE_BUSY_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Optional write protection for POST /produto.
# When set, clients must send X-API-Key with this exact value.
# Required whenever SERIAL_ENABLED=true. Keep empty only for local simulation.
API_TOKEN=

# Camera client
API_URL=http://127.0.0.1:8000/produto

# Next.js dashboard
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
