# Backend / hardware
SERIAL_ENABLED=false
ARDUINO_PORT=/dev/cu.usbserial-120
BAUD_RATE=9600
DATABASE_PATH=api/pacotes.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Optional write protection for POST /produto.
# When set, clients must send X-API-Key with this exact value.
API_TOKEN=

# Camera client
API_URL=http://127.0.0.1:8000/produto

# Next.js dashboard
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
